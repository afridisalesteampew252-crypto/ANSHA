# Browser-safe values only. Never put a service-role key or database password here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
# Public key goes in Vercel + .env.local. Private key is an Edge Function secret only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

