# Browser-safe values only. Never put a service-role key or database password here.

# Canonical production origin for metadata, sitemap, OG, and absolute URLs.
# Production: https://www.anshatradingco.com — do not set preview/localhost as canonical.
NEXT_PUBLIC_SITE_URL=https://www.anshatradingco.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
# Public → Vercel + .env.local (browser subscribe). Private → Supabase Edge secrets only.
# See docs/Deployment.md (PWA section) and docs/PWA.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Local reference for `supabase secrets set` (never commit real values; never NEXT_PUBLIC_*):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@anshatradingco.com

# Android FCM HTTP v1 sender — Supabase Edge Function secret only.
# Set the complete Firebase service-account JSON; never commit it or use NEXT_PUBLIC_*.
# FCM_SERVICE_ACCOUNT_JSON=

# Hourly request due reminders. Same value on Vercel (CRON_SECRET) and the
# remind-request-dues Edge Function secret. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# AI ops assistant (/admin/ai → POST /api/ai/chat). Server-only; never NEXT_PUBLIC_*.
# Prefer Vercel AI Gateway. Falls back to OpenAI when only OPENAI_API_KEY is set.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Optional model id. Gateway default: openai/gpt-5-mini. Direct OpenAI default: gpt-5-mini.
AI_MODEL=

# WhatsApp Cloud API tokens are Edge Function secrets only (never NEXT_PUBLIC_*):
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, optional WHATSAPP_API_VERSION
# See docs/Deployment.md.

# Google Tag Manager (public + portal layouts; not /admin). Publishable container ID.
# Production / Vercel: NEXT_PUBLIC_GTM_ID=GTM-TFSZD9WT (required for deploy bake-in).
# Unset locally → falls back to siteConfig.gtmId. Blank on Preview → disable GTM.
# GA4 and other tags fire from the GTM container — do not also set a direct gtag measurement ID.
NEXT_PUBLIC_GTM_ID=GTM-TFSZD9WT
# First-party measurement path for Google tag gateway (must match vercel.json rewrite).
# Default /metrics → loads /metrics/?id=GTM-… (proxied to gtm-tfszd9wt.fps.goog).
NEXT_PUBLIC_GTM_GATEWAY_PATH=/metrics

# Tawk.to live chat (public site widget). From https://dashboard.tawk.to →
# Administration → Chat Widget → copy Property ID and Widget ID from the embed URL
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>. Leave blank to disable locally.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
# Optional agent dashboard URL for /admin/live-chat (defaults to https://dashboard.tawk.to).
NEXT_PUBLIC_TAWK_DASHBOARD_URL=
# Webhook HMAC secret for Edge Function tawk-webhook (Supabase secrets + local only).
# Never commit a real value. See docs/Tawk.md.
# TAWK_WEBHOOK_SECRET=
# Optional future REST API key (server/Edge only after Tawk grants REST access):
# TAWK_API_KEY=



# Playwright E2E (local/CI only; never target production with mutation tests)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_INVOICE_VERIFICATION_CODE=
E2E_SALES_EMAIL=
E2E_SALES_PASSWORD=
E2E_FREELANCER_EMAIL=
E2E_FREELANCER_PASSWORD=
E2E_ACCOUNTS_EMAIL=
E2E_ACCOUNTS_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ALLOW_MUTATIONS=0
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_STOCK_VEHICLE_ID=
E2E_CUSTOMER_ID=
E2E_CUSTOMER_NAME=
E2E_REMITTANCE_ID=
E2E_INVOICE_ID=
E2E_UNKNOWN_REMITTANCE_ID=
E2E_RECEIVED_BY_USER_ID=
E2E_MULTI_CURRENCY_CUSTOMER_ID=
