{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:brands": "node scripts/verify-brand-assets.mjs",
    "verify:release": "npm run lint && npm run typecheck && npm run verify:brands && npm run build",
    "cap:sync": "npx cap sync",
    "android:prepare-firebase": "node scripts/prepare-android-firebase.mjs",
    "cap:sync:android": "npm run android:prepare-firebase && npx cap sync android",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts tests/e2e/security.spec.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "analyze:bundle": "next experimental-analyze --output",
    "cap:add:admin:android": "npx cap add android",
    "cap:sync:admin:android": "node scripts/prepare-admin-android-firebase.mjs && npx cap sync android",
    "cap:open:admin:android": "npx cap open android"
  },
